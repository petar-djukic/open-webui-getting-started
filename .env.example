# Folder under your home directory that holds your repositories: projects means ~/projects.
WORKSPACE=projects

# Author of commits the model makes.
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL=you@example.com

# Optional tokens that let the main terminal push. See "Pushing" in the README.
GH_TOKEN=
GITLAB_TOKEN=
GITLAB_HOST=gitlab.com

# ./terminals.sh appends OPEN_TERMINAL_API_KEY, COMPOSE_FILE and one TERM_<NAME>_KEY per
# repository terminal. Add TERM_<NAME>_GH_TOKEN or TERM_<NAME>_GITLAB_TOKEN to let one push.
