OPEN_TERMINAL_API_KEY=change-me

# Folder under your home directory with your repositories, e.g. projects for ~/projects.
# The main terminal mounts it read-write.
WORKSPACE=projects

# Optional. ./terminals.sh gets a short-lived admin token from the open-webui container
# to register folder terminals; set an admin API key here only to use that instead.
OPEN_WEBUI_API_KEY=
OPEN_WEBUI_URL=http://localhost:3000

# Git identity for commits made in the terminal.
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL=you@example.com

# Optional: a different email for remotes under one prefix.
GIT_ALT_REMOTE=github.com/some-org
GIT_ALT_EMAIL=you@some-org.example

# Fine-grained GitHub token for git push and gh. Leave empty to disable.
GH_TOKEN=

# GitLab token (api + write_repository scopes) for git push and glab. Leave empty to disable.
GITLAB_TOKEN=
GITLAB_HOST=gitlab.com
